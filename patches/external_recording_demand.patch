@@ -168,8 +168,12 @@ void AudioState::RemoveSendingStream(webrtc::AudioSendStream* stream) {
   auto count = sending_streams_.erase(stream);
   RTC_DCHECK_EQ(1, count);
   UpdateAudioTransportWithSendingStreams();
-  if (sending_streams_.empty()) {
+  if (sending_streams_.empty() &&
+      !config_.audio_device_module->ExternalRecordingDemand()) {
     config_.audio_device_module->StopRecording();
+  } else if (sending_streams_.empty()) {
+    RTC_LOG(LS_INFO)
+        << "Keeping ADM recording active for external recording demand";
   }
 }
 
