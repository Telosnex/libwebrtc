 #ifndef API_AUDIO_AUDIO_DEVICE_H_
 #define API_AUDIO_AUDIO_DEVICE_H_
 
+#include <atomic>
 #include <cstdint>
 #include <optional>
 
@@ -162,6 +163,18 @@ class AudioDeviceModule : public RefCountInterface {
   virtual int32_t StopRecording() = 0;
   virtual bool Recording() const = 0;
 
+  // App-owned capture can outlive all WebRTC send streams. AudioState consults
+  // this demand before stopping the ADM when its final sender is removed.
+  // This state belongs above platform ADMs so the ownership contract is the
+  // same on every platform.
+  int32_t SetExternalRecordingDemand(bool enabled) {
+    external_recording_demand_.store(enabled);
+    return 0;
+  }
+  bool ExternalRecordingDemand() const {
+    return external_recording_demand_.load();
+  }
+
   // Audio mixer initialization
   virtual int32_t InitSpeaker() = 0;
   virtual bool SpeakerIsInitialized() const = 0;
@@ -262,6 +275,9 @@ class AudioDeviceModule : public RefCountInterface {
 
  protected:
   ~AudioDeviceModule() override {}
+
+ private:
+  std::atomic_bool external_recording_demand_{false};
 };
 
