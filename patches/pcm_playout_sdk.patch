+int64_t PeerConnectionFactory::StartPcmPlayout() {
+  RTC_DCHECK_RUN_ON(worker_thread());
+  if (pcm_engine_) return -1;
+  if (!pcm_source_) pcm_source_ = std::make_unique<libwebrtc::PcmPlayoutSource>();
+  auto engine = std::make_unique<ConnectionContext::MediaEngineReference>(context_);
+  if (!engine->media_engine()) return -1;
+  auto state = engine->media_engine()->voice().GetAudioState();
+  if (!state) return -1;
+  const auto generation = pcm_source_->Start();
+  if (generation <= 0) return -1;
+  if (state->AddExternalPlayoutSource(pcm_source_.get()) != 0) {
+    pcm_source_->Stop();
+    return -1;
+  }
+  pcm_engine_ = std::move(engine);
+  return generation;
+}
+int PeerConnectionFactory::WritePcmPlayout(int64_t generation, int64_t epoch, const std::vector<uint8_t>& pcm) {
+  RTC_DCHECK_RUN_ON(worker_thread());
+  return pcm_engine_ ? pcm_source_->Write(generation, epoch, pcm.data(), pcm.size()) : -2;
+}
+int PeerConnectionFactory::ClearPcmPlayout(int64_t generation, int64_t epoch) {
+  RTC_DCHECK_RUN_ON(worker_thread());
+  return pcm_engine_ ? pcm_source_->Clear(generation, epoch) : -2;
 }
+int PeerConnectionFactory::StopPcmPlayout(int64_t generation) {
+  RTC_DCHECK_RUN_ON(worker_thread());
+  if (!pcm_engine_ || pcm_source_->Quiesce(generation) != 0) return -2;
+  if (pcm_engine_->media_engine()->voice().GetAudioState()->RemoveExternalPlayoutSource(pcm_source_.get()) != 0) return -1;
+  pcm_source_->Stop();
+  pcm_engine_.reset();
+  return 0;
+}
+std::vector<int64_t> PeerConnectionFactory::GetPcmPlayoutState() {
+  RTC_DCHECK_RUN_ON(worker_thread());
+  const auto s = pcm_source_ ? pcm_source_->State() : libwebrtc::RTCAudioDevice::PcmPlayoutState{};
+  bool playing = false;
+  int delay = -1;
+  if (pcm_engine_) {
+    // Same ADM that the mixer drives, not a separate platform output.
+    auto* adm = pcm_engine_->media_engine()->voice().GetAudioState()->pcm_audio_device_module();
+    if (adm) {
+      playing = adm->Playing();
+      uint16_t ms = 0;
+      if (adm->PlayoutDelay(&ms) == 0) delay = ms;
+    }
+  }
+  return {s.generation, s.epoch, s.queued_frames, s.accepted_frames, s.consumed_frames,
+          s.discarded_frames, s.render_callbacks, s.underrun_callbacks, playing ? 1 : 0, delay};
+}
 
