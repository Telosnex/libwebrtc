+int AudioState::AddExternalPlayoutSource(AudioMixer::Source* source) {
+  RTC_DCHECK_RUN_ON(&thread_checker_);
+  if (!source || !playout_enabled_ || external_playout_sources_.count(source)) return -1;
+  // NullAudioPoller must never be a second consumer of app PCM.
+  RTC_DCHECK(!null_audio_poller_.Running());
+  auto* adm = config_.audio_device_module.get();
+  if (!adm->Playing() && adm->InitPlayout() != 0) return -1;
+  if (!config_.audio_mixer->AddSource(source)) return -1;
+  if (!adm->Playing() && adm->StartPlayout() != 0) {
+    config_.audio_mixer->RemoveSource(source);
+    return -1;
+  }
+  external_playout_sources_.insert(source);
+  return 0;
+}
+
+int AudioState::RemoveExternalPlayoutSource(AudioMixer::Source* source) {
+  RTC_DCHECK_RUN_ON(&thread_checker_);
+  if (!external_playout_sources_.count(source)) return -1;
+  // Stop first: on failure preserve ownership for retry (caller clears PCM).
+  if (external_playout_sources_.size() == 1 && receiving_streams_.empty() &&
+      config_.audio_device_module->Playing() &&
+      config_.audio_device_module->StopPlayout() != 0) return -1;
+  if (playout_enabled_) config_.audio_mixer->RemoveSource(source);
+  external_playout_sources_.erase(source);
+  return 0;
+}
